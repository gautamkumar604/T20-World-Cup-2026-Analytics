        "measures": [
          {
            "name": "Player Total Wickets",
            "displayFolder": "Phase 4.2 Measures",
            "expression": "SUM(fact_bowling_scorecards[wickets])",
            "formatString": "#,##0",
            "lineageTag": "b6223552-1a21-4cdd-8a3b-cfd1ec5bdfd1"
          },
          {
            "name": "Player Legal Balls",
            "displayFolder": "Phase 4.2 Measures",
            "expression": "SUM(fact_bowling_scorecards[legal_balls])",
            "formatString": "#,##0",
            "lineageTag": "0cbb93ab-61be-4a06-90a8-632cb7f49069"
          },
          {
            "name": "Player Overs Bowled",
            "displayFolder": "Phase 4.2 Measures",
            "expression": "DIVIDE(SUM(fact_bowling_scorecards[legal_balls]), 6, 0)",
            "formatString": "0.0",
            "lineageTag": "618c1542-fa52-466a-b04f-b9df67951227"
          },
          {
            "name": "Player Runs Conceded",
            "displayFolder": "Phase 4.2 Measures",
            "expression": "SUM(fact_bowling_scorecards[runs_conceded])",
            "formatString": "#,##0",
            "lineageTag": "f606052a-19cd-4024-8173-027f9b0d7d9a"
          },
          {
            "name": "Player Economy Rate",
            "displayFolder": "Phase 4.2 Measures",
            "expression": [
              "VAR RunsConc = SUM(fact_bowling_scorecards[runs_conceded])",
              "VAR LegalBalls = SUM(fact_bowling_scorecards[legal_balls])",
              "RETURN",
              "    IF(LegalBalls > 0, DIVIDE(RunsConc, (LegalBalls / 6.0), BLANK()), BLANK())"
            ],
            "formatString": "0.00",
            "lineageTag": "a617805c-6c1a-4400-afd8-16f03808a2ad"
          },
          {
            "name": "Player Economy Rate (Min 10 Overs)",
            "displayFolder": "Phase 4.2 Measures",
            "expression": [
              "VAR RunsConc = SUM(fact_bowling_scorecards[runs_conceded])",
              "VAR LegalBalls = SUM(fact_bowling_scorecards[legal_balls])",
              "RETURN",
              "    IF(LegalBalls >= 60, DIVIDE(RunsConc, (LegalBalls / 6.0), BLANK()), BLANK())"
            ],
            "formatString": "0.00",
            "lineageTag": "5e84bd72-9ffa-4c69-ad41-41800b3e9c38"
          }
        ],
