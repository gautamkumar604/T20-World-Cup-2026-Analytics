              "expression": [
                "let",
                "",
                "    Source = PostgreSQL.Database(\"localhost\", \"t20_worldcup_2026\"),",
                "",
                "    public_fact_deliveries = Source{[Schema=\"public\",Item=\"fact_deliveries\"]}[Data]",
