          {
            "name": "Toss Decision Label",
            "dataType": "string",
            "expression": "IF(ISBLANK(dim_matches[toss_decision]), BLANK(), IF(dim_matches[toss_decision] = \"bat\", \"Bat First\", \"Bowl / Field First\"))",
            "lineageTag": "6f873d76-e92c-4f5a-b7bd-64060c0f478d",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Toss Match Result",
            "dataType": "string",
            "expression": "IF(ISBLANK(dim_matches[toss_decision]) || dim_matches[outcome_type] = \"no result\", BLANK(), IF(dim_matches[toss_winner] = dim_matches[winner], \"Toss Winner Won\", \"Toss Loser Won\"))",
            "lineageTag": "83e43839-782d-4c2f-9e98-ba91349251ec",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "lineageTag": "71d3a1f3-60bf-4249-b197-a971c3b33e73",
        "measures": [
          {
            "name": "Toss Completed Matches",
            "expression": "CALCULATE(COUNTROWS(dim_matches), NOT(ISBLANK(dim_matches[toss_decision])), dim_matches[outcome_type] <> \"no result\")",
            "formatString": "#,##0",
            "lineageTag": "30b6d5ca-facc-44f5-80c8-3b97b8d3fff7"
          }
        ],
        "partitions": [
          {
            "name": "dim_matches-Partition",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "",
                "    Source = PostgreSQL.Database(\"localhost\", \"t20_worldcup_2026\"),",
                "",
                "    public_dim_matches = Source{[Schema=\"public\",Item=\"dim_matches\"]}[Data],",
                "",
                "    AddStage = Table.AddColumn(public_dim_matches, \"Stage_Normalized\", each ",
                "",
                "        if List.Contains({\"A\", \"B\", \"C\", \"D\"}, [group_name]) then \"Group Stage\"",
                "",
                "        else if List.Contains({\"1\", \"2\"}, [group_name]) then \"Super 8\"",
                "",
                "        else if [stage] <> null then [stage]",
                "",
                "        else \"Knockout\", type text),",
                "",
                "    AddGroup = Table.AddColumn(AddStage, \"Tournament_Group\", each ",
                "",
                "        if [group_name] = \"A\" then \"Group A\"",
                "",
                "        else if [group_name] = \"B\" then \"Group B\"",
                "",
                "        else if [group_name] = \"C\" then \"Group C\"",
                "",
                "        else if [group_name] = \"D\" then \"Group D\"",
                "",
                "        else if [group_name] = \"1\" then \"Super 8 - Group 1\"",
                "",
                "        else if [group_name] = \"2\" then \"Super 8 - Group 2\"",
                "",
                "        else \"Playoffs\", type text)",
                "",
                "in",
                "",
                "    AddGroup"
              ],
              "type": "m"
            }
          }
        ]
      },
