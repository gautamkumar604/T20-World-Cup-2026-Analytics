        "lineageTag": "05033d1c-2ac7-497a-a3f3-56c19b169712",
        "measures": [
          {
            "name": "Player Total Runs",
            "displayFolder": "Phase 4.2 Measures",
            "expression": "SUM(fact_batting_scorecards[runs])",
            "formatString": "#,##0",
            "lineageTag": "a51d590a-773d-4aa0-8d41-6c947da208bb"
          },
          {
            "name": "Player Balls Faced",
            "displayFolder": "Phase 4.2 Measures",
            "expression": "SUM(fact_batting_scorecards[balls_faced])",
            "formatString": "#,##0",
            "lineageTag": "e981e38c-1a01-4871-b601-06f1288b6dc6"
          },
          {
            "name": "Player Strike Rate",
            "displayFolder": "Phase 4.2 Measures",
            "expression": "DIVIDE(SUM(fact_batting_scorecards[runs]), SUM(fact_batting_scorecards[balls_faced]), BLANK()) * 100",
            "formatString": "0.00",
            "lineageTag": "8088369c-629b-41d4-80d4-52e28eeffc91"
          },
          {
            "name": "Player Strike Rate (Min 100 Runs)",
            "displayFolder": "Phase 4.2 Measures",
            "expression": [
              "VAR RunsScored = SUM(fact_batting_scorecards[runs])",
              "VAR BallsFaced = SUM(fact_batting_scorecards[balls_faced])",
              "RETURN",
              "    IF(RunsScored >= 100, DIVIDE(RunsScored, BallsFaced, BLANK()) * 100, BLANK())"
            ],
            "formatString": "0.00",
            "lineageTag": "9cc3fa99-a00b-4ead-a0de-ae4e3aaf5f56"
          }
        ],
        "partitions": [
