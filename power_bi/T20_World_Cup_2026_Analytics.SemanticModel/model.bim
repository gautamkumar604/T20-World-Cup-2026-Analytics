          }
        ],
        "lineageTag": "27b8d2f2-fb0b-434d-b79b-6b376910d56b",
        "partitions": [
          {
            "name": "bridge_match_teams-Partition",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "",
                "    Source = PostgreSQL.Database(\"localhost\", \"t20_worldcup_2026\"),",
                "",
                "    Matches = Source{[Schema=\"public\",Item=\"dim_matches\"]}[Data],",
                "",
                "    T1 = Table.SelectColumns(Matches, {\"match_id\", \"team1\", \"team2\", \"winner\", \"outcome_type\", \"venue\"}),",
                "",
                "    T1_Renamed = Table.RenameColumns(T1, {{\"team1\", \"team_name\"}, {\"team2\", \"opponent_team\"}}),",
                "",
                "    T1_Role = Table.AddColumn(T1_Renamed, \"team_role\", each \"team1\", type text),",
                "",
                "    ",
                "",
                "    T2 = Table.SelectColumns(Matches, {\"match_id\", \"team1\", \"team2\", \"winner\", \"outcome_type\", \"venue\"}),",
                "",
                "    T2_Renamed = Table.RenameColumns(T2, {{\"team2\", \"team_name\"}, {\"team1\", \"opponent_team\"}}),",
                "",
                "    T2_Role = Table.AddColumn(T2_Renamed, \"team_role\", each \"team2\", type text),",
                "",
                "    ",
                "",
                "    Combined = Table.Combine({T1_Role, T2_Role}),",
                "",
                "    AddIsWinner = Table.AddColumn(Combined, \"is_winner\", each [winner] = [team_name], type logical),",
                "",
                "    AddIsNoResult = Table.AddColumn(AddIsWinner, \"is_no_result\", each [outcome_type] = \"no result\", type logical)",
                "",
                "in",
                "",
                "    AddIsNoResult"
              ],
              "type": "m"
            }
          }
        ]
      },
