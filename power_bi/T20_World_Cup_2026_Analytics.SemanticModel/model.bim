        "measures": [
          {
            "name": "Tournament Matches Scheduled",
            "expression": "COUNTROWS(dim_matches)",
            "formatString": "#,##0",
            "description": "Total scheduled fixtures in tournament (55 matches at match grain)"
          },
          {
            "name": "Tournament Matches Completed",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] IN {\"runs\", \"wickets\", \"tie_super_over\"})",
            "formatString": "#,##0",
            "description": "Total fixtures completed with a definitive result (53 matches at match grain)"
          },
          {
            "name": "Tournament Matches Abandoned",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] = \"no result\")",
            "formatString": "#,##0",
            "description": "Fixtures abandoned due to rain without result (exactly 2 matches: IRE v ZIM, PAK v NZ)"
          },
          {
            "name": "Tournament Matches Won",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] IN {\"runs\", \"wickets\", \"tie_super_over\"})",
            "formatString": "#,##0",
            "description": "Total fixtures that produced a winning team (53 matches at match grain)"
          },
          {
            "name": "Tournament Matches Lost",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] IN {\"runs\", \"wickets\", \"tie_super_over\"})",
            "formatString": "#,##0",
            "description": "Total fixtures that produced a losing team (53 matches at match grain)"
          },
          {
            "name": "Total Tournament Runs",
            "expression": "CALCULATE(SUM(fact_match_summaries[total_runs]), fact_match_summaries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "description": "Total runs scored across all 53 completed matches excluding super overs (17,582 runs)"
          },
          {
            "name": "Total Tournament Wickets",
            "expression": "CALCULATE(SUM(fact_match_summaries[total_wickets]), fact_match_summaries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "description": "Total wickets fallen across all 53 completed matches excluding super overs (702 wickets)"
          },
          {
            "name": "Tournament Legal Deliveries (Summary)",
            "expression": "CALCULATE(SUM(fact_match_summaries[legal_deliveries]), fact_match_summaries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "description": "Total summary-derived legal deliveries bowled across 53 completed matches (12,059 deliveries)"
          },
          {
            "name": "Total Legal Overs Bowled",
            "expression": "DIVIDE([Tournament Legal Deliveries (Summary)], 6, 0)",
            "formatString": "#,##0.0",
            "description": "Total legal overs completed across 53 matches (2,009.8 overs)"
          },
          {
            "name": "Tournament Run Rate",
            "expression": "DIVIDE([Total Tournament Runs], [Total Legal Overs Bowled], 0)",
            "formatString": "0.00",
            "description": "Tournament overall scoring rate per over across 53 matches (8.75 rpo)"
          },
          {
            "name": "Highest Match Score",
            "expression": "VAR MaxRuns = CALCULATE(MAX(fact_match_summaries[total_runs]), fact_match_summaries[is_super_over] = FALSE())\nVAR TopRow = TOPN(1, FILTER(fact_match_summaries, fact_match_summaries[total_runs] = MaxRuns && fact_match_summaries[is_super_over] = FALSE()), fact_match_summaries[total_runs], DESC)\nVAR TeamName = MAXX(TopRow, fact_match_summaries[batting_team])\nVAR Opponent = MAXX(TopRow, fact_match_summaries[bowling_team])\nVAR Wickets = MAXX(TopRow, fact_match_summaries[total_wickets])\nRETURN\n    IF(NOT ISBLANK(MaxRuns), FORMAT(MaxRuns, \"#,##0\") & \"/\" & FORMAT(Wickets, \"0\") & \" (\" & TeamName & \" vs \" & Opponent & \")\", BLANK())",
            "formatString": "@",
            "description": "Highest score with runs, wickets, team and opponent (256/4 (India vs Zimbabwe))"
          },
          {
            "name": "Bat First Wins",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] = \"runs\")",
            "formatString": "#,##0",
            "description": "Matches won defending total at match grain (29 matches)"
          },
          {
            "name": "Bat First Win %",
            "expression": "DIVIDE([Bat First Wins], [Tournament Matches Completed], 0) * 100",
            "formatString": "0.00'%'",
            "description": "Percentage of completed matches won batting first (54.72%)"
          },
          {
            "name": "Chase Wins",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] = \"wickets\")",
            "formatString": "#,##0",
            "description": "Matches won chasing target at match grain (23 matches)"
          },
          {
            "name": "Chase Win %",
            "expression": "DIVIDE([Chase Wins], [Tournament Matches Completed], 0) * 100",
            "formatString": "0.00'%'",
            "description": "Percentage of completed matches won chasing (43.40%)"
          },
          {
            "name": "Tie Super Over Wins",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] = \"tie_super_over\")",
            "formatString": "#,##0",
            "description": "Matches tied and decided via Super Over (1 match: SA vs AFG)"
          },
          {
            "name": "Tie Super Over Win %",
            "expression": "DIVIDE([Tie Super Over Wins], [Tournament Matches Completed], 0) * 100",
            "formatString": "0.00'%'",
            "description": "Percentage of matches decided by Super Over (1.89%)"
          },
          {
            "name": "Toss Winner Match Wins",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[toss_winner] = dim_matches[winner], dim_matches[outcome_type] IN {\"runs\", \"wickets\", \"tie_super_over\"})",
            "formatString": "#,##0",
            "description": "Matches where toss winner also won match (23 matches)"
          },
          {
            "name": "Toss Winner Win %",
            "expression": "DIVIDE([Toss Winner Match Wins], [Tournament Matches Completed], 0) * 100",
            "formatString": "0.00'%'",
            "description": "Toss win conversion percentage across 53 completed matches (43.40%)"
          },
          {
            "name": "Total Team Wins",
            "expression": "CALCULATE(COUNTROWS(bridge_match_teams), bridge_match_teams[is_winner] = TRUE())",
            "formatString": "#,##0",
            "description": "Total winning team performances across all teams (53 team wins)"
          },
          {
            "name": "Total Team Losses",
            "expression": "CALCULATE(COUNTROWS(bridge_match_teams), bridge_match_teams[is_winner] = FALSE(), bridge_match_teams[is_no_result] = FALSE())",
            "formatString": "#,##0",
            "description": "Total losing team performances across all teams (53 team losses)"
          },
          {
            "name": "Selected Team Matches Scheduled",
            "expression": "DISTINCTCOUNT(bridge_match_teams[match_id])",
            "formatString": "#,##0",
            "description": "Unique count of scheduled fixtures for selected team(s); evaluates to 55 when All Teams selected"
          },
          {
            "name": "Selected Team Matches Completed",
            "expression": "CALCULATE(DISTINCTCOUNT(bridge_match_teams[match_id]), bridge_match_teams[is_no_result] = FALSE())",
            "formatString": "#,##0",
            "description": "Unique count of completed fixtures with a result for selected team(s)"
          },
          {
            "name": "Selected Team Matches Abandoned",
            "expression": "CALCULATE(DISTINCTCOUNT(bridge_match_teams[match_id]), bridge_match_teams[is_no_result] = TRUE())",
            "formatString": "#,##0",
            "description": "Unique count of rain-abandoned matches for selected team(s) (1 each for ZIM and PAK; 2 overall)"
          },
          {
            "name": "Selected Team Matches Won",
            "expression": "CALCULATE(COUNTROWS(bridge_match_teams), bridge_match_teams[is_winner] = TRUE())",
            "formatString": "#,##0",
            "description": "Total matches won by selected team(s)"
          },
          {
            "name": "Selected Team Losses",
            "expression": "CALCULATE(COUNTROWS(bridge_match_teams), bridge_match_teams[is_winner] = FALSE(), bridge_match_teams[is_no_result] = FALSE())",
            "formatString": "#,##0",
            "description": "Total matches lost by selected team(s); evaluates to 53 losing team records when All Teams selected"
          },
          {
            "name": "Tournament Points",
            "expression": "([Selected Team Matches Won] * 2) + ([Selected Team Matches Abandoned] * 1)",
            "formatString": "#,##0",
            "description": "Official ICC tournament points: 2 for Win, 1 for Abandoned (No Result), 0 for Loss"
          },
          {
            "name": "Selected Team Runs Scored",
            "expression": "CALCULATE(\n    SUM(fact_match_summaries[total_runs]),\n    TREATAS(VALUES(bridge_match_teams[match_id]), dim_matches[match_id]),\n    TREATAS(VALUES(dim_teams[team_name]), fact_match_summaries[batting_team]),\n    fact_match_summaries[is_super_over] = FALSE()\n)",
            "formatString": "#,##0",
            "description": "Total runs scored by selected team in regular 20-over innings"
          },
          {
            "name": "Selected Team Opponent Runs",
            "expression": "CALCULATE(\n    SUM(fact_match_summaries[total_runs]),\n    TREATAS(VALUES(bridge_match_teams[match_id]), dim_matches[match_id]),\n    TREATAS(VALUES(dim_teams[team_name]), fact_match_summaries[bowling_team]),\n    fact_match_summaries[is_super_over] = FALSE()\n)",
            "formatString": "#,##0",
            "description": "Total runs conceded by selected team to opponents in regular 20-over innings"
          },
          {
            "name": "Selected Team Match Runs",
            "expression": "CALCULATE(\n    SUM(fact_match_summaries[total_runs]),\n    TREATAS(VALUES(bridge_match_teams[match_id]), dim_matches[match_id]),\n    fact_match_summaries[is_super_over] = FALSE()\n)",
            "formatString": "#,##0",
            "description": "Total match runs scored across both innings in fixtures involving selected team"
          },
          {
            "name": "Selected Team Bat First Wins",
            "expression": "VAR TargetMatches = \n    CALCULATETABLE(\n        VALUES(dim_matches[match_id]),\n        dim_matches[outcome_type] = \"runs\"\n    )\nRETURN\n    CALCULATE(\n        COUNTROWS(bridge_match_teams),\n        bridge_match_teams[is_winner] = TRUE(),\n        TREATAS(TargetMatches, bridge_match_teams[match_id])\n    )",
            "formatString": "#,##0",
            "description": "Matches won defending total by selected team; transfers runs match IDs back to bridge"
          },
          {
            "name": "Selected Team Chase Wins",
            "expression": "VAR TargetMatches = \n    CALCULATETABLE(\n        VALUES(dim_matches[match_id]),\n        dim_matches[outcome_type] = \"wickets\"\n    )\nRETURN\n    CALCULATE(\n        COUNTROWS(bridge_match_teams),\n        bridge_match_teams[is_winner] = TRUE(),\n        TREATAS(TargetMatches, bridge_match_teams[match_id])\n    )",
            "formatString": "#,##0",
            "description": "Matches won chasing target by selected team; transfers wickets match IDs back to bridge"
          },
          {
            "name": "Selected Team Super Over Wins",
            "expression": "VAR TargetMatches = \n    CALCULATETABLE(\n        VALUES(dim_matches[match_id]),\n        dim_matches[outcome_type] = \"tie_super_over\"\n    )\nRETURN\n    CALCULATE(\n        COUNTROWS(bridge_match_teams),\n        bridge_match_teams[is_winner] = TRUE(),\n        TREATAS(TargetMatches, bridge_match_teams[match_id])\n    )",
            "formatString": "#,##0",
            "description": "Matches tied and won via Super Over by selected team (SA vs AFG); transfers tie match IDs back to bridge"
          },
          {
            "name": "Selected Team Matches at Venue",
            "expression": "VAR VenueMatches = VALUES(dim_matches[match_id])\nRETURN\n    CALCULATE(\n        DISTINCTCOUNT(bridge_match_teams[match_id]),\n        TREATAS(VenueMatches, bridge_match_teams[match_id])\n    )",
            "formatString": "#,##0",
            "description": "Matches played by selected team at current venue context; BLANK for venues not visited"
          },
          {
            "name": "Selected Team Wins at Venue",
            "expression": "VAR VenueMatches = VALUES(dim_matches[match_id])\nRETURN\n    CALCULATE(\n        COUNTROWS(bridge_match_teams),\n        bridge_match_teams[is_winner] = TRUE(),\n        TREATAS(VenueMatches, bridge_match_teams[match_id])\n    )",
            "formatString": "#,##0",
            "description": "Matches won by selected team at current venue context"
          },
          {
            "name": "Team Balls Faced (ICC NRR)",
            "expression": "CALCULATE(\n    SUMX(\n        fact_match_summaries,\n        IF(fact_match_summaries[total_wickets] = 10, 120, fact_match_summaries[legal_deliveries])\n    ),\n    TREATAS(VALUES(dim_teams[team_name]), fact_match_summaries[batting_team]),\n    fact_match_summaries[is_super_over] = FALSE()\n)",
            "formatString": "#,##0",
            "description": "Legal balls faced with ICC 120-ball all-out rule applied"
          },
          {
            "name": "Team Balls Bowled (ICC NRR)",
            "expression": "CALCULATE(\n    SUM(fact_match_summaries[legal_deliveries]),\n    TREATAS(VALUES(dim_teams[team_name]), fact_match_summaries[bowling_team]),\n    fact_match_summaries[is_super_over] = FALSE()\n)",
            "formatString": "#,##0",
            "description": "Actual legal deliveries bowled by the team (ICC Clause 16.10.7: all-out full quota adjustment applies strictly to batting team balls faced)"
          },
          {
            "name": "Net Run Rate (ICC)",
            "expression": "VAR RunsFor = [Selected Team Runs Scored]\nVAR BallsFor = [Team Balls Faced (ICC NRR)]\nVAR OversFor = DIVIDE(BallsFor, 6, 0)\nVAR RunsAgainst = [Selected Team Opponent Runs]\nVAR BallsAgainst = [Team Balls Bowled (ICC NRR)]\nVAR OversAgainst = DIVIDE(BallsAgainst, 6, 0)\nRETURN\n    IF(\n        OversFor > 0 && OversAgainst > 0,\n        DIVIDE(RunsFor, OversFor, 0) - DIVIDE(RunsAgainst, OversAgainst, 0),\n        BLANK()\n    )",
            "formatString": "+0.000;-0.000;0.000",
            "description": "Official ICC Net Run Rate (Run Rate For minus Run Rate Against)"
          }
        ]
      },
      {
        "name": "bridge_match_teams",
        "columns": [
          {
            "name": "match_id",
            "dataType": "string",
            "sourceColumn": "match_id",
            "isNullable": false
          },
          {
            "name": "team_name",
            "dataType": "string",
            "sourceColumn": "team_name",
            "isNullable": false
          },
          {
            "name": "opponent_team",
            "dataType": "string",
            "sourceColumn": "opponent_team",
            "isNullable": false
          },
          {
            "name": "team_role",
            "dataType": "string",
            "sourceColumn": "team_role",
            "isNullable": false
          },
          {
            "name": "winner",
            "dataType": "string",
            "sourceColumn": "winner",
            "isNullable": false
          },
          {
            "name": "outcome_type",
            "dataType": "string",
            "sourceColumn": "outcome_type",
            "isNullable": false
          },
          {
            "name": "venue",
            "dataType": "string",
            "sourceColumn": "venue",
            "isNullable": false
          },
          {
            "name": "is_winner",
            "dataType": "boolean",
            "sourceColumn": "is_winner",
            "isNullable": false
          },
          {
            "name": "is_no_result",
            "dataType": "boolean",
            "sourceColumn": "is_no_result",
            "isNullable": false
          }
        ],
        "partitions": [
          {
            "name": "bridge_match_teams-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let\n",
                "    Source = PostgreSQL.Database(\"localhost\", \"t20_worldcup_2026\"),\n",
                "    Matches = Source{[Schema=\"public\",Item=\"dim_matches\"]}[Data],\n",
                "    T1 = Table.SelectColumns(Matches, {\"match_id\", \"team1\", \"team2\", \"winner\", \"outcome_type\", \"venue\"}),\n",
                "    T1_Renamed = Table.RenameColumns(T1, {{\"team1\", \"team_name\"}, {\"team2\", \"opponent_team\"}}),\n",
                "    T1_Role = Table.AddColumn(T1_Renamed, \"team_role\", each \"team1\", type text),\n",
                "    \n",
                "    T2 = Table.SelectColumns(Matches, {\"match_id\", \"team1\", \"team2\", \"winner\", \"outcome_type\", \"venue\"}),\n",
                "    T2_Renamed = Table.RenameColumns(T2, {{\"team2\", \"team_name\"}, {\"team1\", \"opponent_team\"}}),\n",
                "    T2_Role = Table.AddColumn(T2_Renamed, \"team_role\", each \"team2\", type text),\n",
                "    \n",
                "    Combined = Table.Combine({T1_Role, T2_Role}),\n",
                "    AddIsWinner = Table.AddColumn(Combined, \"is_winner\", each [winner] = [team_name], type logical),\n",
                "    AddIsNoResult = Table.AddColumn(AddIsWinner, \"is_no_result\", each [outcome_type] = \"no result\", type logical)\n",
                "in\n",
                "    AddIsNoResult\n"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "dim_teams_to_bridge_active",
        "fromTable": "bridge_match_teams",
        "fromColumn": "team_name",
        "toTable": "dim_teams",
        "toColumn": "team_name",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      },
      {
        "name": "dim_matches_to_bridge_active",
        "fromTable": "bridge_match_teams",
        "fromColumn": "match_id",
        "toTable": "dim_matches",
        "toColumn": "match_id",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      },
      {
        "name": "dim_teams_to_dim_players_team_active",
        "fromTable": "dim_players",
        "fromColumn": "team",
        "toTable": "dim_teams",
        "toColumn": "team_name",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      },
      {
        "name": "dim_venues_to_dim_matches_venue_active",
        "fromTable": "dim_matches",
        "fromColumn": "venue",
        "toTable": "dim_venues",
        "toColumn": "venue_name",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      },
      {
        "name": "dim_matches_to_fact_summaries_active",
        "fromTable": "fact_match_summaries",
        "fromColumn": "match_id",
        "toTable": "dim_matches",
        "toColumn": "match_id",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      },
      {
        "name": "dim_matches_to_fact_batting_active",
        "fromTable": "fact_batting_scorecards",
        "fromColumn": "match_id",
        "toTable": "dim_matches",
        "toColumn": "match_id",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      },
      {
        "name": "dim_matches_to_fact_bowling_active",
        "fromTable": "fact_bowling_scorecards",
        "fromColumn": "match_id",
        "toTable": "dim_matches",
        "toColumn": "match_id",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      },
      {
        "name": "dim_matches_to_fact_deliveries_active",
        "fromTable": "fact_deliveries",
        "fromColumn": "match_id",
        "toTable": "dim_matches",
        "toColumn": "match_id",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      },
      {
        "name": "dim_players_to_fact_batting_active",
        "fromTable": "fact_batting_scorecards",
        "fromColumn": "player_id",
        "toTable": "dim_players",
        "toColumn": "player_id",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      },
      {
        "name": "dim_players_to_fact_bowling_active",
        "fromTable": "fact_bowling_scorecards",
        "fromColumn": "player_id",
        "toTable": "dim_players",
        "toColumn": "player_id",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      },
      {
        "name": "dim_players_to_fact_deliveries_batter_active",
        "fromTable": "fact_deliveries",
        "fromColumn": "batter_id",
        "toTable": "dim_players",
        "toColumn": "player_id",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      },
      {
        "name": "dim_players_to_fact_deliveries_bowler_inactive",
        "fromTable": "fact_deliveries",
        "fromColumn": "bowler_id",
        "toTable": "dim_players",
        "toColumn": "player_id",
        "crossFilteringBehavior": "oneDirection",
        "isActive": false
      },
      {
        "name": "dim_players_to_fact_deliveries_non_striker_inactive",
        "fromTable": "fact_deliveries",
        "fromColumn": "non_striker_id",
        "toTable": "dim_players",
        "toColumn": "player_id",
        "crossFilteringBehavior": "oneDirection",
        "isActive": false
      }
    ]
  }
}