            "sourceColumn": "is_wicket"
          },
          {
            "name": "wicket_kind",
            "dataType": "string",
            "lineageTag": "88da4e3d-3e16-4c50-bae4-0ad09e650207",
            "sourceColumn": "wicket_kind"
          },
          {
            "name": "player_dismissed",
            "dataType": "string",
            "lineageTag": "88e941af-8a8c-4e15-8308-899a94ac36f2",
            "sourceColumn": "player_dismissed"
          },
          {
            "name": "fielder_involved",
            "dataType": "string",
            "lineageTag": "562374f3-99e5-4f06-9cb9-5ac55b2d011d",
            "sourceColumn": "fielder_involved"
          },
          {
            "name": "is_super_over",
            "dataType": "boolean",
            "isNullable": false,
            "lineageTag": "d671d187-afa5-4b58-a7b9-7d7bb25daa90",
            "sourceColumn": "is_super_over"
          }
        ],
        "lineageTag": "7e46ebbe-937e-46d0-8b16-0480524e9c6d",
        "measures": [
          {
            "name": "Powerplay Run Rate",
            "expression": [
              "VAR TotalRuns = CALCULATE(SUM(fact_deliveries[total_runs]), fact_deliveries[phase] = \"Powerplay\", fact_deliveries[is_super_over] = FALSE())",
              "VAR LegalBalls = CALCULATE(COUNTROWS(fact_deliveries), fact_deliveries[phase] = \"Powerplay\", fact_deliveries[is_legal_delivery] = TRUE(), fact_deliveries[is_super_over] = FALSE())",
              "RETURN DIVIDE(TotalRuns * 6.0, LegalBalls, BLANK())"
            ],
            "formatString": "0.00",
            "lineageTag": "735fe86b-2e42-4d29-9c28-f824206b1047"
          },
          {
            "name": "Powerplay Wickets",
            "expression": "CALCULATE(COUNTROWS(fact_deliveries), fact_deliveries[phase] = \"Powerplay\", fact_deliveries[is_wicket] = TRUE(), fact_deliveries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "32b010d0-8ac6-4c35-866a-2d1b78817b4c"
          },
          {
            "name": "Middle Overs Run Rate",
            "expression": [
              "VAR TotalRuns = CALCULATE(SUM(fact_deliveries[total_runs]), fact_deliveries[phase] = \"Middle\", fact_deliveries[is_super_over] = FALSE())",
              "VAR LegalBalls = CALCULATE(COUNTROWS(fact_deliveries), fact_deliveries[phase] = \"Middle\", fact_deliveries[is_legal_delivery] = TRUE(), fact_deliveries[is_super_over] = FALSE())",
              "RETURN DIVIDE(TotalRuns * 6.0, LegalBalls, BLANK())"
            ],
            "formatString": "0.00",
            "lineageTag": "216340a1-dee9-46b8-9628-921fab11593a"
          },
          {
            "name": "Middle Overs Wickets",
            "expression": "CALCULATE(COUNTROWS(fact_deliveries), fact_deliveries[phase] = \"Middle\", fact_deliveries[is_wicket] = TRUE(), fact_deliveries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "17219789-8d0e-44bd-a112-4b98ca3dd9be"
          },
          {
            "name": "Death Overs Run Rate",
            "expression": [
              "VAR TotalRuns = CALCULATE(SUM(fact_deliveries[total_runs]), fact_deliveries[phase] = \"Death\", fact_deliveries[is_super_over] = FALSE())",
              "VAR LegalBalls = CALCULATE(COUNTROWS(fact_deliveries), fact_deliveries[phase] = \"Death\", fact_deliveries[is_legal_delivery] = TRUE(), fact_deliveries[is_super_over] = FALSE())",
              "RETURN DIVIDE(TotalRuns * 6.0, LegalBalls, BLANK())"
            ],
            "formatString": "0.00",
            "lineageTag": "bf3a0117-1c7c-4986-96df-56f620f9a0bb"
          },
          {
            "name": "Death Overs Wickets",
            "expression": "CALCULATE(COUNTROWS(fact_deliveries), fact_deliveries[phase] = \"Death\", fact_deliveries[is_wicket] = TRUE(), fact_deliveries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "e93d246b-3969-4a90-a345-e431e2b3ba29"
          },
          {
            "name": "Phase Total Fours",
            "expression": "CALCULATE(COUNTROWS(fact_deliveries), fact_deliveries[is_boundary_four] = TRUE(), fact_deliveries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "f6c2ce85-d9ab-4d7f-96e1-50852c12149b"
          },
          {
            "name": "Phase Total Sixes",
            "expression": "CALCULATE(COUNTROWS(fact_deliveries), fact_deliveries[is_boundary_six] = TRUE(), fact_deliveries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "46d77c38-baf5-4812-8418-8b93296f7292"
          },
          {
            "name": "Phase Total Boundaries",
            "expression": "CALCULATE(COUNTROWS(fact_deliveries), (fact_deliveries[is_boundary_four] = TRUE() || fact_deliveries[is_boundary_six] = TRUE()), fact_deliveries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "7ce12486-1ad1-4330-854e-c3a5a5c7c9b8"
          },
          {
            "name": "Bowler Powerplay Wickets",
            "expression": [
              "CALCULATE(",
              "    COUNTROWS(fact_deliveries),",
              "    fact_deliveries[phase] = \"Powerplay\",",
              "    fact_deliveries[is_wicket] = TRUE(),",
              "    fact_deliveries[wicket_kind] <> \"run out\",",
              "    fact_deliveries[wicket_kind] <> \"retired hurt\",",
              "    fact_deliveries[wicket_kind] <> \"retired out\",",
              "    fact_deliveries[is_super_over] = FALSE()",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "61953867-e199-4c2d-9d32-c618f8e499e0"
          },
          {
            "name": "Bowler Powerplay Overs",
            "expression": [
              "VAR LegalBalls = CALCULATE(",
              "    COUNTROWS(fact_deliveries),",
              "    fact_deliveries[phase] = \"Powerplay\",",
              "    fact_deliveries[is_legal_delivery] = TRUE(),",
              "    fact_deliveries[is_super_over] = FALSE()",
              ")",
              "VAR FullOvers = INT(DIVIDE(LegalBalls, 6, 0))",
              "VAR RemBalls = MOD(LegalBalls, 6)",
              "RETURN FullOvers + DIVIDE(RemBalls, 10, 0)"
            ],
            "formatString": "0.0",
            "lineageTag": "5c8e1b35-00be-4508-8956-fb8c8a317622"
          },
          {
            "name": "Bowler Powerplay Economy",
            "expression": [
              "VAR RunsConc = CALCULATE(",
              "    SUM(fact_deliveries[total_runs]),",
              "    fact_deliveries[phase] = \"Powerplay\",",
              "    fact_deliveries[is_super_over] = FALSE()",
              ")",
              "VAR LegalBalls = CALCULATE(",
              "    COUNTROWS(fact_deliveries),",
              "    fact_deliveries[phase] = \"Powerplay\",",
              "    fact_deliveries[is_legal_delivery] = TRUE(),",
              "    fact_deliveries[is_super_over] = FALSE()",
              ")",
              "RETURN DIVIDE(RunsConc * 6.0, LegalBalls, BLANK())"
            ],
            "formatString": "0.00",
            "lineageTag": "36c6f109-5420-448e-98b5-72d45244a2bc"
          },
          {
            "name": "Bowler Death Overs Economy (Min 10 Balls)",
            "expression": [
              "VAR RunsConc = CALCULATE(",
              "    SUM(fact_deliveries[total_runs]),",
              "    fact_deliveries[phase] = \"Death\",",
              "    fact_deliveries[is_super_over] = FALSE()",
              ")",
              "VAR LegalBalls = CALCULATE(",
              "    COUNTROWS(fact_deliveries),",
              "    fact_deliveries[phase] = \"Death\",",
              "    fact_deliveries[is_legal_delivery] = TRUE(),",
              "    fact_deliveries[is_super_over] = FALSE()",
              ")",
              "RETURN IF(LegalBalls >= 10, DIVIDE(RunsConc * 6.0, LegalBalls, BLANK()), BLANK())"
            ],
            "formatString": "0.00",
            "lineageTag": "07262e74-11e3-4b38-b95f-81ae47033b04"
          },
          {
            "name": "Bowler Death Overs Wickets",
            "expression": [
              "CALCULATE(",
              "    COUNTROWS(fact_deliveries),",
              "    fact_deliveries[phase] = \"Death\",",
              "    fact_deliveries[is_wicket] = TRUE(),",
              "    fact_deliveries[wicket_kind] <> \"run out\",",
              "    fact_deliveries[wicket_kind] <> \"retired hurt\",",
              "    fact_deliveries[wicket_kind] <> \"retired out\",",
              "    fact_deliveries[is_super_over] = FALSE()",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "ee6d42a2-096e-40fb-9c9d-151679eeb73a"
          },
          {
            "name": "Bowler Death Overs Balls",
            "expression": [
              "CALCULATE(",
              "    COUNTROWS(fact_deliveries),",
              "    fact_deliveries[phase] = \"Death\",",
              "    fact_deliveries[is_legal_delivery] = TRUE(),",
              "    fact_deliveries[is_super_over] = FALSE()",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "309308d6-d771-4013-a9a2-9fcba0fd81ae"
          }
        ],
        "partitions": [
          {
