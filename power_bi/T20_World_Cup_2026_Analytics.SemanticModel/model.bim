        "measures": [
          {
            "name": "Tournament Matches Scheduled",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Total scheduled fixtures in tournament (55 matches at match grain)",
            "expression": "COUNTROWS(dim_matches)",
            "formatString": "#,##0",
            "lineageTag": "c88bd7bd-bb6a-4248-b5a0-e51e2a113ea0"
          },
          {
            "name": "Tournament Matches Completed",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Total fixtures completed with a definitive result (53 matches at match grain)",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] IN {\"runs\", \"wickets\", \"tie_super_over\"})",
            "formatString": "#,##0",
            "lineageTag": "919fe0d2-cb23-4271-bb5d-4201d438a51c"
          },
          {
            "name": "Tournament Matches Abandoned",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Fixtures abandoned due to rain without result (exactly 2 matches: IRE v ZIM, PAK v NZ)",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] = \"no result\")",
            "formatString": "#,##0",
            "lineageTag": "3162f3b0-c824-41cd-b72b-a32553deea8b"
          },
          {
            "name": "Tournament Matches Won",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Total fixtures that produced a winning team (53 matches at match grain)",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] IN {\"runs\", \"wickets\", \"tie_super_over\"})",
            "formatString": "#,##0",
            "lineageTag": "95be87ea-66ef-472c-94a9-4db4f82d9227"
          },
          {
            "name": "Tournament Matches Lost",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Total fixtures that produced a losing team (53 matches at match grain)",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] IN {\"runs\", \"wickets\", \"tie_super_over\"})",
            "formatString": "#,##0",
            "lineageTag": "5373bb2e-2410-41e8-8eb1-bb17f7fa041e"
          },
          {
            "name": "Total Tournament Runs",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Total runs scored across all 53 completed matches excluding super overs (17,582 runs)",
            "expression": "CALCULATE(SUM(fact_match_summaries[total_runs]), fact_match_summaries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "281bfe8f-34d6-4548-8882-27163f5a217a"
          },
          {
            "name": "Total Tournament Wickets",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Total wickets fallen across all 53 completed matches excluding super overs (702 wickets)",
            "expression": "CALCULATE(SUM(fact_match_summaries[total_wickets]), fact_match_summaries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "bac44ed3-52be-4dfd-9c8f-a55289295546"
          },
          {
            "name": "Tournament Legal Deliveries (Summary)",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Total summary-derived legal deliveries bowled across 53 completed matches (12,059 deliveries)",
            "expression": "CALCULATE(SUM(fact_match_summaries[legal_deliveries]), fact_match_summaries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "dfb0f9bd-f8c8-4b11-a962-6fd00bb4b157"
          },
          {
            "name": "Total Legal Overs Bowled",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Total legal overs completed across 53 matches (2,009.8 overs)",
            "expression": "DIVIDE([Tournament Legal Deliveries (Summary)], 6, 0)",
            "formatString": "#,##0.0",
            "lineageTag": "eba776e9-f945-460d-9303-2b07e3ff8807"
          },
          {
            "name": "Tournament Run Rate",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Tournament overall scoring rate per over across 53 matches (8.75 rpo)",
            "expression": "DIVIDE([Total Tournament Runs], [Total Legal Overs Bowled], 0)",
            "formatString": "0.00",
            "lineageTag": "00c0af93-54c1-428b-8a57-400da7df13e6"
          },
          {
            "name": "Highest Match Score",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Highest score with runs, wickets, team and opponent (256/4 (India vs Zimbabwe))",
            "expression": [
              "VAR MaxRuns = CALCULATE(MAX(fact_match_summaries[total_runs]), fact_match_summaries[is_super_over] = FALSE())",
              "VAR TopRow = TOPN(1, FILTER(fact_match_summaries, fact_match_summaries[total_runs] = MaxRuns && fact_match_summaries[is_super_over] = FALSE()), fact_match_summaries[total_runs], DESC)",
              "VAR TeamName = MAXX(TopRow, fact_match_summaries[batting_team])",
              "VAR Opponent = MAXX(TopRow, fact_match_summaries[bowling_team])",
              "VAR Wickets = MAXX(TopRow, fact_match_summaries[total_wickets])",
              "RETURN",
              "    IF(NOT ISBLANK(MaxRuns), FORMAT(MaxRuns, \"#,##0\") & \"/\" & FORMAT(Wickets, \"0\") & \" (\" & TeamName & \" vs \" & Opponent & \")\", BLANK())"
            ],
            "formatString": "@",
            "lineageTag": "66108421-db35-420e-9e44-55d1a0cbca6d"
          },
          {
            "name": "Bat First Wins",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Matches won defending total at match grain (29 matches)",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] = \"runs\")",
            "formatString": "#,##0",
            "lineageTag": "05d1112a-1d0e-4683-a3ab-b4cc015cee29"
          },
          {
            "name": "Bat First Win %",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Percentage of completed matches won batting first (54.72%)",
            "expression": "DIVIDE([Bat First Wins], [Tournament Matches Completed], 0) * 100",
            "formatString": "0.00'%'",
            "lineageTag": "1fc6489d-b94f-4d82-8cca-901a17a214b9"
          },
          {
            "name": "Chase Wins",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Matches won chasing target at match grain (23 matches)",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] = \"wickets\")",
            "formatString": "#,##0",
            "lineageTag": "517b72c0-f23f-42d1-b4bd-da4d6e2717cc"
          },
          {
            "name": "Chase Win %",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Percentage of completed matches won chasing (43.40%)",
            "expression": "DIVIDE([Chase Wins], [Tournament Matches Completed], 0) * 100",
            "formatString": "0.00'%'",
            "lineageTag": "728078ba-ed44-4e21-9b1a-fa215daca95c"
          },
          {
            "name": "Tie Super Over Wins",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Matches tied and decided via Super Over (1 match: SA vs AFG)",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] = \"tie_super_over\")",
            "formatString": "#,##0",
            "lineageTag": "8fc24324-6ddb-42ca-b735-d58279ae4a16"
          },
          {
            "name": "Tie Super Over Win %",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Percentage of matches decided by Super Over (1.89%)",
            "expression": "DIVIDE([Tie Super Over Wins], [Tournament Matches Completed], 0) * 100",
            "formatString": "0.00'%'",
            "lineageTag": "2e509b0a-8fab-4d7b-81fb-134d6782dde4"
          },
          {
            "name": "Toss Winner Match Wins",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Matches where toss winner also won match (23 matches)",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[toss_winner] = dim_matches[winner], dim_matches[outcome_type] IN {\"runs\", \"wickets\", \"tie_super_over\"})",
            "formatString": "#,##0",
            "lineageTag": "a182a796-37ba-4410-9b7b-eb26dd38f700"
          },
          {
            "name": "Toss Winner Win %",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Toss win conversion percentage across 53 completed matches (43.40%)",
            "expression": "DIVIDE([Toss Winner Match Wins], [Tournament Matches Completed], 0) * 100",
            "formatString": "0.00'%'",
            "lineageTag": "66c2b8fc-485b-4a0c-8f7c-88454fb27a95"
          },
          {
            "name": "Total Team Wins",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Total winning team performances across all teams (53 team wins)",
            "expression": "CALCULATE(COUNTROWS(bridge_match_teams), bridge_match_teams[is_winner] = TRUE())",
            "formatString": "#,##0",
            "lineageTag": "bc66fdc2-b322-4dbb-8bb0-0d2dde30d45d"
          },
          {
            "name": "Total Team Losses",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Total losing team performances across all teams (53 team losses)",
            "expression": "CALCULATE(COUNTROWS(bridge_match_teams), bridge_match_teams[is_winner] = FALSE(), bridge_match_teams[is_no_result] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "8f4190a1-1830-48e1-9c9d-9b49f7cb6f98"
          },
          {
            "name": "Selected Team Matches Scheduled",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Unique count of scheduled fixtures for selected team(s); evaluates to 55 when All Teams selected",
            "expression": "DISTINCTCOUNT(bridge_match_teams[match_id])",
            "formatString": "#,##0",
            "lineageTag": "8c472661-5363-4f81-8cdc-d68a0db6c210"
          },
          {
            "name": "Selected Team Matches Completed",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Unique count of completed fixtures with a result for selected team(s)",
            "expression": "CALCULATE(DISTINCTCOUNT(bridge_match_teams[match_id]), bridge_match_teams[is_no_result] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "2b512dd2-5d77-4ced-a367-4cd8826c46c4"
          },
          {
            "name": "Selected Team Matches Abandoned",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Unique count of rain-abandoned matches for selected team(s) (1 each for ZIM and PAK; 2 overall)",
            "expression": "CALCULATE(DISTINCTCOUNT(bridge_match_teams[match_id]), bridge_match_teams[is_no_result] = TRUE())",
            "formatString": "#,##0",
            "lineageTag": "80d22235-6995-4567-bf8b-cadbd3f82260"
          },
          {
            "name": "Selected Team Matches Won",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Total matches won by selected team(s)",
            "expression": "CALCULATE(COUNTROWS(bridge_match_teams), bridge_match_teams[is_winner] = TRUE())",
            "formatString": "#,##0",
            "lineageTag": "30b8d342-f9c5-4811-bb0b-8927688fed90"
          },
          {
            "name": "Selected Team Losses",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Total matches lost by selected team(s); evaluates to 53 losing team records when All Teams selected",
            "expression": "CALCULATE(COUNTROWS(bridge_match_teams), bridge_match_teams[is_winner] = FALSE(), bridge_match_teams[is_no_result] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "cab54430-09c2-49e4-bdb6-8d5c6e9e36e9"
          },
          {
            "name": "Tournament Points",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Official ICC tournament points: 2 for Win, 1 for Abandoned (No Result), 0 for Loss",
            "expression": "([Selected Team Matches Won] * 2) + ([Selected Team Matches Abandoned] * 1)",
            "formatString": "#,##0",
            "lineageTag": "97a783d3-042f-401a-acfa-a4dc3aad241a"
          },
          {
            "name": "Selected Team Runs Scored",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Total runs scored by selected team in regular 20-over innings",
            "expression": [
              "CALCULATE(",
              "    SUM(fact_match_summaries[total_runs]),",
              "    TREATAS(VALUES(bridge_match_teams[match_id]), dim_matches[match_id]),",
              "    TREATAS(VALUES(dim_teams[team_name]), fact_match_summaries[batting_team]),",
              "    fact_match_summaries[is_super_over] = FALSE()",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "8ffa0b32-3ea4-4395-a540-f33455a9a1c0"
          },
          {
            "name": "Selected Team Opponent Runs",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Total runs conceded by selected team to opponents in regular 20-over innings",
            "expression": [
              "CALCULATE(",
              "    SUM(fact_match_summaries[total_runs]),",
              "    TREATAS(VALUES(bridge_match_teams[match_id]), dim_matches[match_id]),",
              "    TREATAS(VALUES(dim_teams[team_name]), fact_match_summaries[bowling_team]),",
              "    fact_match_summaries[is_super_over] = FALSE()",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "d3cf2491-fa18-4824-a551-e0d94953a3d5"
          },
          {
            "name": "Selected Team Match Runs",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Total match runs scored across both innings in fixtures involving selected team",
            "expression": [
              "CALCULATE(",
              "    SUM(fact_match_summaries[total_runs]),",
              "    TREATAS(VALUES(bridge_match_teams[match_id]), dim_matches[match_id]),",
              "    fact_match_summaries[is_super_over] = FALSE()",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "cd331c03-c27d-434b-9704-3513f97c2844"
          },
          {
            "name": "Selected Team Bat First Wins",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Matches won defending total by selected team; transfers runs match IDs back to bridge",
            "expression": [
              "VAR TargetMatches = ",
              "    CALCULATETABLE(",
              "        VALUES(dim_matches[match_id]),",
              "        dim_matches[outcome_type] = \"runs\"",
              "    )",
              "RETURN",
              "    CALCULATE(",
              "        COUNTROWS(bridge_match_teams),",
              "        bridge_match_teams[is_winner] = TRUE(),",
              "        TREATAS(TargetMatches, bridge_match_teams[match_id])",
              "    )"
            ],
            "formatString": "#,##0",
            "lineageTag": "be9f9d51-bf39-46dc-be8f-828385f98900"
          },
          {
            "name": "Selected Team Chase Wins",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Matches won chasing target by selected team; transfers wickets match IDs back to bridge",
            "expression": [
              "VAR TargetMatches = ",
              "    CALCULATETABLE(",
              "        VALUES(dim_matches[match_id]),",
              "        dim_matches[outcome_type] = \"wickets\"",
              "    )",
              "RETURN",
              "    CALCULATE(",
              "        COUNTROWS(bridge_match_teams),",
              "        bridge_match_teams[is_winner] = TRUE(),",
              "        TREATAS(TargetMatches, bridge_match_teams[match_id])",
              "    )"
            ],
            "formatString": "#,##0",
            "lineageTag": "e033f516-f0fb-4df3-87da-974e4f2e23e4"
          },
          {
            "name": "Selected Team Super Over Wins",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Matches tied and won via Super Over by selected team (SA vs AFG); transfers tie match IDs back to bridge",
            "expression": [
              "VAR TargetMatches = ",
              "    CALCULATETABLE(",
              "        VALUES(dim_matches[match_id]),",
              "        dim_matches[outcome_type] = \"tie_super_over\"",
              "    )",
              "RETURN",
              "    CALCULATE(",
              "        COUNTROWS(bridge_match_teams),",
              "        bridge_match_teams[is_winner] = TRUE(),",
              "        TREATAS(TargetMatches, bridge_match_teams[match_id])",
              "    )"
            ],
            "formatString": "#,##0",
            "lineageTag": "bd3ebd72-bbf0-4cc8-8d24-6c66703f7f6d"
          },
          {
            "name": "Selected Team Matches at Venue",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Matches played by selected team at current venue context; BLANK for venues not visited",
            "expression": [
              "VAR VenueMatches = VALUES(dim_matches[match_id])",
              "RETURN",
              "    CALCULATE(",
              "        DISTINCTCOUNT(bridge_match_teams[match_id]),",
              "        TREATAS(VenueMatches, bridge_match_teams[match_id])",
              "    )"
            ],
            "formatString": "#,##0",
            "lineageTag": "301faa28-bc18-436f-938d-ea950f7af441"
          },
          {
            "name": "Selected Team Wins at Venue",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Matches won by selected team at current venue context",
            "expression": [
              "VAR VenueMatches = VALUES(dim_matches[match_id])",
              "RETURN",
              "    CALCULATE(",
              "        COUNTROWS(bridge_match_teams),",
              "        bridge_match_teams[is_winner] = TRUE(),",
              "        TREATAS(VenueMatches, bridge_match_teams[match_id])",
              "    )"
            ],
            "formatString": "#,##0",
            "lineageTag": "aed1a70b-89e9-4c5c-a239-2cabe61933b6"
          },
          {
            "name": "Team Balls Faced (ICC NRR)",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Legal balls faced with ICC 120-ball all-out rule applied",
            "expression": [
              "CALCULATE(",
              "    SUMX(",
              "        fact_match_summaries,",
              "        IF(fact_match_summaries[total_wickets] = 10, 120, fact_match_summaries[legal_deliveries])",
              "    ),",
              "    TREATAS(VALUES(dim_teams[team_name]), fact_match_summaries[batting_team]),",
              "    fact_match_summaries[is_super_over] = FALSE()",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "8e491740-6f69-4849-81ec-3bbac0be552b"
          },
          {
            "name": "Team Balls Bowled (ICC NRR)",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Actual legal deliveries bowled by the team (ICC Clause 16.10.7: all-out full quota adjustment applies strictly to batting team balls faced)",
            "expression": [
              "CALCULATE(",
              "    SUM(fact_match_summaries[legal_deliveries]),",
              "    TREATAS(VALUES(dim_teams[team_name]), fact_match_summaries[bowling_team]),",
              "    fact_match_summaries[is_super_over] = FALSE()",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "0fbbdc0e-c735-474c-9386-e8c02c2a85a7"
          },
          {
            "name": "Net Run Rate (ICC)",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "description": "Official ICC Net Run Rate (Run Rate For minus Run Rate Against)",
            "expression": [
              "VAR RunsFor = [Selected Team Runs Scored]",
              "VAR BallsFor = [Team Balls Faced (ICC NRR)]",
              "VAR OversFor = DIVIDE(BallsFor, 6, 0)",
              "VAR RunsAgainst = [Selected Team Opponent Runs]",
              "VAR BallsAgainst = [Team Balls Bowled (ICC NRR)]",
              "VAR OversAgainst = DIVIDE(BallsAgainst, 6, 0)",
              "RETURN",
              "    IF(",
              "        OversFor > 0 && OversAgainst > 0,",
              "        DIVIDE(RunsFor, OversFor, 0) - DIVIDE(RunsAgainst, OversAgainst, 0),",
              "        BLANK()",
              "    )"
            ],
            "formatString": "+0.000;-0.000;0.000",
            "lineageTag": "aa93d957-06a4-4a5b-aa1e-ce51f04c97c0"
          },
          {
            "name": "Lowest Match Score",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "Phase 4.2 Measures",
            "expression": [
              "VAR MinRuns = CALCULATE(MIN(fact_match_summaries[total_runs]), fact_match_summaries[is_super_over] = FALSE())",
              "VAR TopRow = TOPN(1, FILTER(fact_match_summaries, fact_match_summaries[total_runs] = MinRuns && fact_match_summaries[is_super_over] = FALSE()), fact_match_summaries[total_runs], ASC)",
              "VAR TeamName = MAXX(TopRow, fact_match_summaries[batting_team])",
              "VAR Opponent = MAXX(TopRow, fact_match_summaries[bowling_team])",
              "VAR Wickets = MAXX(TopRow, fact_match_summaries[total_wickets])",
              "RETURN",
              "    IF(NOT ISBLANK(MinRuns), FORMAT(MinRuns, \"#,##0\") & \"/\" & FORMAT(Wickets, \"0\") & \" (\" & TeamName & \" vs \" & Opponent & \")\", BLANK())"
            ],
            "lineageTag": "a35ad45c-6b44-4c50-a9ca-62c060736772"
          },
          {
            "name": "Lowest Team Score",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "Phase 4.2 Measures",
            "expression": "CALCULATE(MIN(fact_match_summaries[total_runs]), fact_match_summaries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "afd3c6d1-7165-4760-b836-23bc20c9f266"
          },
          {
            "name": "Highest Team Score",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "Phase 4.2 Measures",
            "expression": "CALCULATE(MAX(fact_match_summaries[total_runs]), fact_match_summaries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "ba01b983-a6cc-4e76-b019-74aabcbcc29b"
          },
          {
            "name": "Team Win Pct",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "Phase 4.2 Measures",
            "expression": [
              "VAR MatchesWon = [Selected Team Matches Won]",
              "VAR MatchesCompleted = [Selected Team Matches Completed]",
              "RETURN",
              "    IF(MatchesCompleted > 0, DIVIDE(MatchesWon, MatchesCompleted, BLANK()) * 100, BLANK())"
            ],
            "formatString": "0.0\"%\"",
            "lineageTag": "d6364801-5013-4f51-9368-80428388129b"
          },
          {
            "name": "Venue Avg First Innings Score",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "Phase 4.2 Measures",
            "expression": [
              "CALCULATE(",
              "    AVERAGE(fact_match_summaries[total_runs]),",
              "    fact_match_summaries[innings] = 1,",
              "    fact_match_summaries[is_super_over] = FALSE()",
              ")"
            ],
            "formatString": "0.0",
            "lineageTag": "bf32db12-606a-485f-abc1-1467c2e2d411"
          },
          {
            "name": "Venue Avg Second Innings Score",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "Phase 4.2 Measures",
            "expression": [
              "CALCULATE(",
              "    AVERAGE(fact_match_summaries[total_runs]),",
              "    fact_match_summaries[innings] = 2,",
              "    fact_match_summaries[is_super_over] = FALSE()",
              ")"
            ],
            "formatString": "0.0",
            "lineageTag": "ece2ae53-cfb2-406e-b5dd-731feeccda87"
          }
        ],
        "partitions": [
          {
            "name": "fact_match_summaries-Partition",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "",
                "    Source = PostgreSQL.Database(\"localhost\", \"t20_worldcup_2026\"),",
                "",
                "    public_fact_match_summaries = Source{[Schema=\"public\",Item=\"fact_match_summaries\"]}[Data]",
                "",
                "in",
                "",
                "    public_fact_match_summaries"
              ],
              "type": "m"
            }
          }
        ]
      },
