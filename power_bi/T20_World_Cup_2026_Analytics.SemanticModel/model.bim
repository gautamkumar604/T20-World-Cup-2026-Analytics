          {
            "name": "is_dot_ball",
            "dataType": "boolean",
            "isNullable": false,
            "lineageTag": "ce05e4c2-838e-4f64-9f83-ff1a1f82ed7d",
            "sourceColumn": "is_dot_ball"
          },
          {
            "name": "is_wicket",
            "dataType": "boolean",
