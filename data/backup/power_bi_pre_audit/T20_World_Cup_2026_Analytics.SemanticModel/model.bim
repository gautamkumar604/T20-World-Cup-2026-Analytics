        "partitions": [
          {
            "name": "fact_match_summaries-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let\n",
                "    Source = PostgreSQL.Database(\"localhost\", \"t20_worldcup_2026\"),\n",
                "    public_fact_match_summaries = Source{[Schema=\"public\",Item=\"fact_match_summaries\"]}[Data]\n",
                "in\n",
                "    public_fact_match_summaries\n"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Matches Scheduled",
            "expression": "COUNTROWS(dim_matches)",
            "formatString": "#,##0",
            "description": "Total scheduled fixtures in the tournament (55 matches)"
          },
          {
            "name": "Matches Completed",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] IN {\"runs\", \"wickets\", \"tie_super_over\"})",
            "formatString": "#,##0",
            "description": "Total fixtures completed with a result (53 matches)"
          },
          {
            "name": "Matches Abandoned",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] = \"no_result\")",
            "formatString": "#,##0",
            "description": "Fixtures abandoned due to rain without result (2 matches)"
          },
          {
            "name": "Total Tournament Runs",
            "expression": "CALCULATE(SUM(fact_match_summaries[total_runs]), fact_match_summaries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "description": "Total runs scored across all 53 completed matches excluding super overs (17,582 runs)"
          },
          {
            "name": "Total Tournament Wickets",
            "expression": "CALCULATE(SUM(fact_match_summaries[total_wickets]), fact_match_summaries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "description": "Total wickets fallen across all 53 completed matches excluding super overs (702 wickets)"
          },
          {
            "name": "Total Legal Overs Bowled",
            "expression": "DIVIDE(CALCULATE(SUM(fact_match_summaries[legal_deliveries]), fact_match_summaries[is_super_over] = FALSE()), 6, 0)",
            "formatString": "#,##0.0",
            "description": "Total legal overs completed across 53 matches (2,009.8 overs)"
          },
          {
            "name": "Tournament Run Rate",
            "expression": "DIVIDE([Total Tournament Runs], [Total Legal Overs Bowled], 0)",
            "formatString": "0.00",
            "description": "Tournament overall scoring rate per over across 53 matches (8.75 rpo)"
          },
          {
            "name": "Highest Match Score",
            "expression": "CALCULATE(MAX(fact_match_summaries[total_runs]), fact_match_summaries[is_super_over] = FALSE())",
            "formatString": "#,##0",
            "description": "Highest team innings score in tournament (256/4 by India vs Zimbabwe)"
          },
          {
            "name": "Bat First Wins",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] = \"runs\")",
            "formatString": "#,##0",
            "description": "Matches won defending total (29 matches)"
          },
          {
            "name": "Bat First Win %",
            "expression": "DIVIDE([Bat First Wins], [Matches Completed], 0) * 100",
            "formatString": "0.00'%'",
            "description": "Percentage of completed matches won batting first (54.72%)"
          },
          {
            "name": "Chase Wins",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] = \"wickets\")",
            "formatString": "#,##0",
            "description": "Matches won chasing target (23 matches)"
          },
          {
            "name": "Chase Win %",
            "expression": "DIVIDE([Chase Wins], [Matches Completed], 0) * 100",
            "formatString": "0.00'%'",
            "description": "Percentage of completed matches won chasing (43.40%)"
          },
          {
            "name": "Tie Super Over Wins",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[outcome_type] = \"tie_super_over\")",
            "formatString": "#,##0",
            "description": "Matches tied and decided via Super Over (1 match: SA vs AFG)"
          },
          {
            "name": "Tie Super Over Win %",
            "expression": "DIVIDE([Tie Super Over Wins], [Matches Completed], 0) * 100",
            "formatString": "0.00'%'",
            "description": "Percentage of matches decided by Super Over (1.89%)"
          },
          {
            "name": "Toss Winner Match Wins",
            "expression": "CALCULATE(COUNTROWS(dim_matches), dim_matches[toss_winner] = dim_matches[winner], dim_matches[outcome_type] IN {\"runs\", \"wickets\", \"tie_super_over\"})",
            "formatString": "#,##0",
            "description": "Matches where toss winner also won match (23 matches)"
          },
          {
            "name": "Toss Winner Win %",
            "expression": "DIVIDE([Toss Winner Match Wins], [Matches Completed], 0) * 100",
            "formatString": "0.00'%'",
            "description": "Toss win conversion percentage across 53 completed matches (43.40%)"
          },
          {
            "name": "Total Fours (Scorecard)",
            "expression": "SUM(fact_batting_scorecards[fours])",
            "formatString": "#,##0",
            "description": "Total boundaries hit for 4 runs across 49 scorecard matches (1,328 fours)"
          },
          {
            "name": "Total Sixes (Scorecard)",
            "expression": "SUM(fact_batting_scorecards[sixes])",
            "formatString": "#,##0",
            "description": "Total boundaries hit for 6 runs across 49 scorecard matches (718 sixes)"
          },
          {
            "name": "Batting Strike Rate",
            "expression": "DIVIDE(SUM(fact_batting_scorecards[runs]), SUM(fact_batting_scorecards[balls_faced]), 0) * 100",
            "formatString": "0.00",
            "description": "Overall batting strike rate across 49 scorecard matches (139.02)"
          },
          {
            "name": "Bowling Economy Rate",
            "expression": "DIVIDE(SUM(fact_bowling_scorecards[runs_conceded]), DIVIDE(SUM(fact_bowling_scorecards[legal_balls]), 6, 0), 0)",
            "formatString": "0.00",
            "description": "Overall bowling economy rate across 49 scorecard matches (8.64 rpo)"
          },
          {
            "name": "Bowler Dot Ball %",
            "expression": "DIVIDE(SUM(fact_bowling_scorecards[dots]), SUM(fact_bowling_scorecards[legal_balls]), 0) * 100",
            "formatString": "0.00'%'",
            "description": "Percentage of legal balls bowled as dots across 49 scorecard matches (36.14%)"
          }
        ]
      }
    ],
